# SORUPILOT: Trendyol Soru Asistanı
# BotFather token'ı. BotFather > /newbot > Bot Settings > Business Mode AÇIK
BOT_TOKEN=
BOT_USERNAME=SoruPilotBot
# python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Panelin yayınlandığı HTTPS adres (webhook: /telegram/webhook)
WEBAPP_URL=https://sorupilot.example.com
PRODUCT_NAME=SoruPilot

# Yapay zeka: anthropic | openai | echo (echo = anahtarsız geliştirme modu)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Plan (Telegram Stars aboneliği, 30 günde bir yenilenir)
SALES_ENABLED=false
TRIAL_REPLIES=50
PLAN_STARS=750
PLAN_REPLIES=2000
PLAYGROUND_DAILY=30
SUPPORT_TEXT=Ödeme ve hesap desteği: destek@ornek.com
TERMS_TEXT=Vekil, işletmenizin Telegram mesajlarına sizin verdiğiniz bilgilerle yapay zeka ile cevap verir. Cevapların doğruluğundan hesap sahibi sorumludur. İade talepleri 7 gün içinde /paysupport ile.

# Güvenlik sınırları
MAX_REPLIES_PER_CHAT_HOUR=30
MAX_MESSAGE_AGE=600
ADMIN_IDS=
DB_PATH=data/vekil.sqlite3
